# Dagestan — local development environment
# Copy to .env.local and fill in the keys you want to use.
# All keys are stored in your browser's localStorage at runtime; these
# values are only used during `npm run dev` / `npm run build`.

# OpenCode Zen (100% free, recommended)
# Sign up: https://opencode.ai/auth
OPENCODE_ZEN_API_KEY=

# OpenRouter (free tiers available)
# Sign up: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# NVIDIA NIM (free credits)
# Sign up: https://build.nvidia.com
NVIDIA_API_KEY=

# Exa (live web search inside the chat)
# Sign up: https://exa.ai
EXA_API_KEY=
