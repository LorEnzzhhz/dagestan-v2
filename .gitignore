# Dependencies
node_modules

# Build output
dist

# Local env
.env.local

# Android (dagestan-android) local build artifacts
dagestan-android/android/local.properties
dagestan-android/android/.gradle/
dagestan-android/android/app/build/

# Bundled packages (downloaded during CI build, not tracked in git)
dagestan-android/android/app/src/main/assets/packages/

# Capacitor generated Android project (built in CI). ONLY matches
# a top-level 'android/' directory (the Capacitor default), NOT
# 'dagestan-android/android/' which is our actual Android project.
/android/
/android/app/build/
/android/.gradle/
/android/local.properties

# Vite build output shipped into Android WebView (regenerated by CI)
dagestan-android/android/app/src/main/assets/web/assets/

# Dagestan local secrets — never commit API keys
.dagestan/
src/lib/api-key-pool.local.ts
secrets.json
*.local.json

# Build-output is for local testing only
build-output/*

# Vendored upstream trees — these are full repos with ~50k files.
# Clone separately and use the start-real-*.sh helpers. We commit
# only the entry-point metadata.
opencodex/
openclaw-real/

# Re-include only the entry-point metadata for each vendored tree
!opencodex/package.json
!opencodex/README.md
!opencodex/LICENSE
!opencodex/bunfig.toml
!opencodex/tsconfig.json
!opencodex/.gitignore
!openclaw-real/package.json
!openclaw-real/openclaw.mjs
!openclaw-real/README.md
!openclaw-real/LICENSE
!openclaw-real/pnpm-workspace.yaml
!openclaw-real/pnpm-lock.yaml
!openclaw-real/node-version.mjs
!openclaw-real/node-version.d.mts
!openclaw-real/AGENTS.md
!openclaw-real/.gitignore

# Playwright CLI artifacts — local debugging only
.playwright-cli/

# Pre-built web bundle in android assets — generated by 'npm run build'
# then copied via 'cp -r dist/* dagestan-android/android/app/src/main/assets/web/'
# Per the README. Never commit it (it can contain API keys).
dagestan-android/android/app/src/main/assets/web/
