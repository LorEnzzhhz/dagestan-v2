'use strict';
const FREE_MODELS = [{"id":"openrouter/free","object":"model","owned_by":"openrouter","context_length":32768,"free":true},{"id":"meituan/longcat-flash-chat:free","object":"model","owned_by":"meituan","context_length":32768,"free":true},{"id":"deepseek/deepseek-chat-v3-0324:free","object":"model","owned_by":"deepseek","context_length":32768,"free":true},{"id":"meta-llama/llama-3.3-70b-instruct:free","object":"model","owned_by":"meta-llama","context_length":32768,"free":true},{"id":"google/gemma-3-27b-it:free","object":"model","owned_by":"google","context_length":32768,"free":true},{"id":"qwen/qwen3-coder:free","object":"model","owned_by":"qwen","context_length":32768,"free":true},{"id":"nousresearch/hermes-3-llama-3.1-405b:free","object":"model","owned_by":"nousresearch","context_length":32768,"free":true},{"id":"nousresearch/hermes-3-llama-3.1-70b:free","object":"model","owned_by":"nousresearch","context_length":32768,"free":true},{"id":"inclusionai/ling-3.0-flash-fin:free","object":"model","owned_by":"inclusionai","context_length":32768,"free":true},{"id":"dots-studio/dots-3-note-preview:free","object":"model","owned_by":"dots-studio","context_length":32768,"free":true},{"id":"liquid/lfm-2.5-2.6b:free","object":"model","owned_by":"liquid","context_length":32768,"free":true},{"id":"nvidia/nemotron-3.5-lightning:free","object":"model","owned_by":"nvidia","context_length":32768,"free":true},{"id":"thinkingmachines/inkling-small:free","object":"model","owned_by":"thinkingmachines","context_length":32768,"free":true},{"id":"poolside/laguna-s-2.1:free","object":"model","owned_by":"poolside","context_length":32768,"free":true},{"id":"thinkingmachines/inkling:free","object":"model","owned_by":"thinkingmachines","context_length":32768,"free":true},{"id":"poolside/laguna-xs-2.1:free","object":"model","owned_by":"poolside","context_length":32768,"free":true},{"id":"cohere/north-mini-code:free","object":"model","owned_by":"cohere","context_length":32768,"free":true},{"id":"z-ai/glm-5.2:free","object":"model","owned_by":"z-ai","context_length":32768,"free":true},{"id":"nvidia/nemotron-3-ultra-550b-a55b:free","object":"model","owned_by":"nvidia","context_length":32768,"free":true},{"id":"google/gemma-4-26b-a4b-it:free","object":"model","owned_by":"google","context_length":32768,"free":true},{"id":"google/gemma-4-31b-it:free","object":"model","owned_by":"google","context_length":32768,"free":true},{"id":"nvidia/nemotron-3-super-120b-a12b:free","object":"model","owned_by":"nvidia","context_length":32768,"free":true},{"id":"local","object":"model","owned_by":"dagestan","context_length":32768,"free":true}];
const http = require('http');
const sharedRouter = require('./shared/dagestan-router.cjs');
function readBody(req) { return new Promise((resolve) => { const chunks = []; req.on('data', c => chunks.push(c)); req.on('end', () => resolve(Buffer.concat(chunks).toString('utf8'))); }); }
const PORT_MAIN = 8788;
const UPSTREAM = process.env.DAGESTAN_LOCAL_MODELS || 'http://127.0.0.1:18927';
let _reqCount = 0;
let _log = [];
const log = (lvl, msg) => { _log.unshift({ ts: new Date().toISOString().slice(11, 19), lvl, msg }); if (_log.length > 500) _log.pop(); };
log('info', 'Hermes gateway (Dagestan rebrand) starting');
const SESSIONS = new Map();
let SESSION_COUNTER = 0;
function newSessionId() { SESSION_COUNTER += 1; return 'sess_' + Date.now().toString(36) + '_' + SESSION_COUNTER; }
function readBody(req) { return new Promise((resolve) => { const chunks = []; req.on('data', (c) => chunks.push(c)); req.on('end', () => resolve(Buffer.concat(chunks).toString('utf8'))); }); }
// ---- Provider table (loaded from secrets.local.json at boot) ----
const PROXY_PROVIDERS = {};
const PROXY_POOL = { openrouter: [], nvidia: [], zen: [] };
const PROXY_IDX = { openrouter: 0, nvidia: 0, zen: 0 };
function loadProxySecrets() {
  try {
    const fs = require('fs');
    const path = require('path');
    const candidates = [
      path.join(process.cwd(), 'secrets.local.json'),
      path.join(process.env.HOME || '/root', 'dagestan', 'secrets.local.json'),
    ];
    for (const p of candidates) {
      if (!fs.existsSync(p)) continue;
      const j = JSON.parse(fs.readFileSync(p, 'utf8'));
      for (const [provider, keys] of Object.entries(j.providers || {})) {
        const list = (keys || []).map(k => k.key).filter(Boolean);
        if (list.length === 0) continue;
        PROXY_PROVIDERS[provider] = list;
        if (PROXY_POOL[provider]) PROXY_POOL[provider] = list;
      }
      break;
    }
  } catch (e) { /* ignore */ }
}
const PROXY_URLS = {
  openrouter: 'https://openrouter.ai/api/v1/chat/completions',
  nvidia:     'https://integrate.api.nvidia.com/v1/chat/completions',
  zen:        'https://opencode.ai/zen/v1/chat/completions',
};
function proxyUrlForModel(model) {
  if (!model) return null;
  if (model.startsWith('openrouter/') || model === 'openrouter/free') return { url: PROXY_URLS.openrouter, provider: 'openrouter', headers: { 'HTTP-Referer': 'https://dagestan.app', 'X-Title': 'Dagestan' } };
  if (model.startsWith('nvidia/') || model.startsWith('meta/') || model.startsWith('deepseek-ai/') || model.startsWith('qwen/') || model.startsWith('tencent/')) return { url: PROXY_URLS.nvidia, provider: 'nvidia', headers: {} };
  if (['big-pickle', 'x-preview-f-free', 'mimo-v2.5-free', 'nemotron-3-ultra-free', 'nemotron-3.5-lightning-free'].includes(model)) return { url: PROXY_URLS.zen, provider: 'zen', headers: {} };
  return null;
}
function proxyUpstreamChat(payload, target, key) {
  return new Promise((resolve, reject) => {
    const body = JSON.stringify({ ...payload, stream: false });
    const u = new URL(target.url);
    const mod = u.protocol === 'https:' ? require('https') : http;
    const r = mod.request({
      method: 'POST', hostname: u.hostname, port: u.port || 443, path: u.pathname,
      headers: {
        'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(body),
        'Authorization': 'Bearer ' + key, ...(target.headers || {}),
      },
    }, (resp) => {
      const chunks = [];
      resp.on('data', c => chunks.push(c));
      resp.on('end', () => resolve({ status: resp.statusCode, body: Buffer.concat(chunks).toString('utf8') }));
      resp.on('error', reject);
    });
    r.on('error', reject);
    r.write(body);
    r.end();
  });
}
function proxyUpstreamStream(payload, target, key, socket) {
  const body = JSON.stringify({ ...payload, stream: true });
  const u = new URL(target.url);
  const mod = u.protocol === 'https:' ? require('https') : http;
    const r = mod.request({
    method: 'POST', hostname: u.hostname, port: u.port || 443, path: u.pathname,
    headers: {
      'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(body),
      'Authorization': 'Bearer ' + key, ...(target.headers || {}),
    },
  }, (resp) => {
    if (resp.statusCode !== 200) {
      try { socket.write('data: {"error":{"message":"upstream ' + resp.statusCode + '"}}\n\ndata: [DONE]\n\n'); } catch {}
      return;
    }
    resp.pipe(socket);
  });
  r.on('error', e => { try { socket.write('data: {"error":{"message":"' + e.message + '"}}\n\ndata: [DONE]\n\n'); } catch {} });
  r.write(body);
  r.end();
}
function routeProxyChat(payload, res, isStream) {
  const target = proxyUrlForModel(payload.model);
  const pool = target ? PROXY_POOL[target.provider] : [];
  if (!target || pool.length === 0) {
    return isStream
      ? streamChat(payload, res)
      : proxyChat(payload).then(r => { res.writeHead(200, hdr('application/json')); res.end(r); }).catch(e => { res.writeHead(502, hdr('application/json')); res.end(JSON.stringify({ error: { message: e.message } })); });
  }
  const tryKey = (i) => {
    if (i >= pool.length) {
      const msg = 'all upstream keys failed';
      if (isStream) { try { res.write('data: {"error":{"message":"' + msg + '"}}\n\ndata: [DONE]\n\n'); res.end(); } catch {} }
      else { res.writeHead(502, hdr('application/json')); res.end(JSON.stringify({ error: { message: msg } })); }
      return;
    }
    const key = pool[i];
    const ks = typeof key === 'string' ? key.slice(0, 8) : '<none>';
    console.log('[hermes] trying key#' + i + ' startsWith=' + ks + ' model=' + payload.model);
    if (isStream) {
      try {
        res.writeHead(200, Object.assign(hdr('text/event-stream'), { 'Transfer-Encoding': 'chunked' }));
        proxyUpstreamStream(payload, target, key, res);
      } catch { tryKey(i + 1); }
    } else {
      proxyUpstreamChat(payload, target, key).then(r => {
        const bodyPreview = typeof r.body === 'string' ? r.body.slice(0, 120) : '<no body>';
        console.log('[hermes] upstream status=' + r.status + ' key#' + i + ' body=' + bodyPreview);
        if (r.status >= 200 && r.status < 300) { res.writeHead(200, hdr('application/json')); res.end(r.body); }
        else { tryKey(i + 1); }
      }).catch(() => tryKey(i + 1));
    }
  };
  tryKey(0);
}
loadProxySecrets();

function proxyChat(payload) { return new Promise((resolve, reject) => { const body = JSON.stringify({ ...payload, stream: false }); const u = new URL(UPSTREAM + '/v1/chat/completions'); const r = http.request({ method: 'POST', hostname: u.hostname, port: u.port || 80, path: u.pathname, headers: { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(body) } }, (resp) => { let data = ''; resp.on('data', (c) => { data += c; }); resp.on('end', () => { resolve(data); }); resp.on('error', reject); }); r.on('error', reject); r.write(body); r.end(); }); }
function streamChat(payload, socket) { const body = JSON.stringify({ ...payload, stream: true }); const u = new URL(UPSTREAM + '/v1/chat/completions'); const r = http.request({ method: 'POST', hostname: u.hostname, port: u.port || 80, path: u.pathname, headers: { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(body) } }, (resp) => { if (resp.statusCode !== 200) { socket.write('data: {"error": {"message": "upstream ' + resp.statusCode + '"}}\n\ndata: [DONE]\n\n'); return; } resp.pipe(socket); }); r.on('error', (e) => { socket.write('data: {"error": {"message": "' + e.message + '"}}\n\ndata: [DONE]\n\n'); }); r.write(body); r.end(); }
function cors() { return { 'Access-Control-Allow-Origin': '*', 'Access-Control-Allow-Methods': 'GET, POST, OPTIONS', 'Access-Control-Allow-Headers': 'Content-Type, Authorization' }; }
function hdr(type) { return Object.assign({ 'Content-Type': type + '; charset=utf-8', 'Cache-Control': 'no-cache' }, cors()); }
const DAGESTAN_DASH = '<!DOCTYPE html>\n<html lang="en">\n<head>\n<meta charset="utf-8" />\n<meta name="viewport" content="width=device-width,initial-scale=1" />\n<title>Dagestan Dashboard</title>\n<style>\n:root{--bg:#0b0d12;--fg:#e8eaed;--muted:#7b8497;--accent:#38bdf8;--card:#11141b;--border:#1e2230}\n*{box-sizing:border-box;margin:0;padding:0}\nhtml,body{height:100%}\nbody{font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:var(--bg);color:var(--fg);display:flex;align-items:center;justify-content:center;padding:1.5rem}\n.shell{max-width:520px;width:100%;background:var(--card);border:1px solid var(--border);border-radius:14px;padding:1.5rem}\nh1{font-size:1.1rem;font-weight:600;margin-bottom:.25rem}\np{color:var(--muted);font-size:.875rem;line-height:1.5;margin-bottom:1rem}\n.btn{display:inline-flex;align-items:center;gap:.5rem;background:var(--accent);color:#0b0d12;text-decoration:none;padding:.55rem 1rem;border-radius:8px;font-weight:600;font-size:.875rem}\n.btn:hover{filter:brightness(1.1)}\n.kbd{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.75rem;background:#0b0d12;border:1px solid var(--border);padding:.1rem .35rem;border-radius:4px}\n</style>\n</head>\n<body>\n<div class="shell">\n<h1>Dagestan Dashboard</h1>\n<p>This service\'s API is reachable at <span class="kbd">/v1/chat/completions</span>. The unified web dashboard lives on the main Dagestan port.</p>\n<a class="btn" href="http://127.0.0.1:5173/dashboard">Open Dagestan Dashboard &rarr;</a>\n</div>\n</body>\n</html>';
const handler = async (req, res) => {
  _reqCount += 1;
  const u = new URL(req.url, 'http://localhost');
  if (req.method === 'OPTIONS') { res.writeHead(204, cors()); return res.end(); }
  if (req.method === 'GET' && (u.pathname === '/' || u.pathname === '/index.html' || u.pathname === '')) { res.writeHead(200, hdr('text/html')); return res.end(DAGESTAN_DASH); }
  if (u.pathname === '/readyz' || u.pathname === '/healthz') { res.writeHead(200, hdr('text/plain')); return res.end('ok'); }
  if (u.pathname === '/api/status') { res.writeHead(200, hdr('application/json')); return res.end(JSON.stringify({ status: 'running', port: PORT_MAIN, uptime: process.uptime(), requests: _reqCount, sessions: SESSIONS.size, version: '1.0.0', name: 'hermes', brand: 'Dagestan Hermes' })); }
  if (u.pathname === '/v1/models') { res.writeHead(200, hdr('application/json')); return res.end(JSON.stringify({ object: 'list', data: FREE_MODELS })); }
  if (u.pathname === '/api/sessions' && req.method === 'POST') { const body = await readBody(req); try { const data = JSON.parse(body); const sid = newSessionId(); const session = { id: sid, title: (data.message || 'Chat').slice(0, 60), model: data.model || 'local', createdAt: Date.now(), messages: [] }; SESSIONS.set(sid, session); res.writeHead(200, hdr('application/json')); return res.end(JSON.stringify({ sessionId: sid, session })); } catch (e) { res.writeHead(400, hdr('application/json')); return res.end(JSON.stringify({ error: { message: 'invalid request' } })); } }
  if (u.pathname === '/api/logs') { res.writeHead(200, hdr('application/json')); return res.end(JSON.stringify(_log.slice(0, 100))); }
  if (req.method === 'POST' && u.pathname === '/v1/chat/completions') {
    const body = await readBody(req);
    let data = {}; try { data = JSON.parse(body || '{}'); } catch (e) { res.writeHead(400, hdr('application/json')); return res.end(JSON.stringify({ error: { message: e.message } })); }
    const r = sharedRouter.routeProxyChat(data, res, !!data.stream, { 'Access-Control-Allow-Origin': '*', 'Access-Control-Allow-Methods': 'GET, POST, OPTIONS', 'Access-Control-Allow-Headers': 'Content-Type, Authorization' });
    if (r.handled) return;
  }
  res.writeHead(200, hdr('text/html'));
  res.end(HTML);
};
const server = http.createServer(handler);
server.listen(8788, '0.0.0.0', () => log('info', 'Hermes gateway on :8788'));
process.on('uncaughtException', (e) => { console.error('Hermes err:', e.message); });

const HTML = Buffer.from('', 'base64').toString('utf8');