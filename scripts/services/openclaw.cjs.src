// ============================================================================
// Dagestan OpenClaw — rebranded faithful copy of openclaw/openclaw Control UI.
// Gateway + Control UI with WebSocket protocol (RFC 6455).
// ============================================================================
'use strict';
const FREE_MODELS = [{"id":"openrouter/free","object":"model","owned_by":"openrouter","context_length":32768,"free":true},{"id":"meituan/longcat-flash-chat:free","object":"model","owned_by":"meituan","context_length":32768,"free":true},{"id":"deepseek/deepseek-chat-v3-0324:free","object":"model","owned_by":"deepseek","context_length":32768,"free":true},{"id":"meta-llama/llama-3.3-70b-instruct:free","object":"model","owned_by":"meta-llama","context_length":32768,"free":true},{"id":"google/gemma-3-27b-it:free","object":"model","owned_by":"google","context_length":32768,"free":true},{"id":"qwen/qwen3-coder:free","object":"model","owned_by":"qwen","context_length":32768,"free":true},{"id":"nousresearch/hermes-3-llama-3.1-405b:free","object":"model","owned_by":"nousresearch","context_length":32768,"free":true},{"id":"nousresearch/hermes-3-llama-3.1-70b:free","object":"model","owned_by":"nousresearch","context_length":32768,"free":true},{"id":"inclusionai/ling-3.0-flash-fin:free","object":"model","owned_by":"inclusionai","context_length":32768,"free":true},{"id":"dots-studio/dots-3-note-preview:free","object":"model","owned_by":"dots-studio","context_length":32768,"free":true},{"id":"liquid/lfm-2.5-2.6b:free","object":"model","owned_by":"liquid","context_length":32768,"free":true},{"id":"nvidia/nemotron-3.5-lightning:free","object":"model","owned_by":"nvidia","context_length":32768,"free":true},{"id":"thinkingmachines/inkling-small:free","object":"model","owned_by":"thinkingmachines","context_length":32768,"free":true},{"id":"poolside/laguna-s-2.1:free","object":"model","owned_by":"poolside","context_length":32768,"free":true},{"id":"thinkingmachines/inkling:free","object":"model","owned_by":"thinkingmachines","context_length":32768,"free":true},{"id":"poolside/laguna-xs-2.1:free","object":"model","owned_by":"poolside","context_length":32768,"free":true},{"id":"cohere/north-mini-code:free","object":"model","owned_by":"cohere","context_length":32768,"free":true},{"id":"z-ai/glm-5.2:free","object":"model","owned_by":"z-ai","context_length":32768,"free":true},{"id":"nvidia/nemotron-3-ultra-550b-a55b:free","object":"model","owned_by":"nvidia","context_length":32768,"free":true},{"id":"google/gemma-4-26b-a4b-it:free","object":"model","owned_by":"google","context_length":32768,"free":true},{"id":"google/gemma-4-31b-it:free","object":"model","owned_by":"google","context_length":32768,"free":true},{"id":"nvidia/nemotron-3-super-120b-a12b:free","object":"model","owned_by":"nvidia","context_length":32768,"free":true},{"id":"local","object":"model","owned_by":"dagestan","context_length":32768,"free":true}];
const http = require('http');
const crypto = require('crypto');
const { routeProxyChat } = require('./shared/dagestan-router.cjs');
function readBody(req) { return new Promise((resolve) => { const chunks = []; req.on('data', c => chunks.push(c)); req.on('end', () => resolve(Buffer.concat(chunks).toString('utf8'))); }); }

const PORT_MAIN = 18790;
const PORT_CTRL = 19002;
const UPSTREAM = process.env.DAGESTAN_LOCAL_MODELS || 'http://127.0.0.1:18927';

let _reqCount = 0;
let _log = [];
function log(lvl, msg) {
  _log.unshift({ ts: new Date().toISOString().slice(11, 19), lvl, msg });
  if (_log.length > 500) _log.pop();
}
log('info', 'OpenClaw gateway (Dagestan rebrand) starting');
log('info', 'WebSocket protocol v4 ready');

// ---- gateway session core ----
const SESSIONS = new Map();
let SESSION_COUNTER = 0;
function newSessionId() { SESSION_COUNTER += 1; return 'sess_' + Date.now().toString(36) + '_' + SESSION_COUNTER; }

function sendFrame(socket, payloadObj) {
  const payload = Buffer.from(JSON.stringify(payloadObj), 'utf8');
  if (payload.length < 126) {
    socket.write(Buffer.concat([Buffer.from([0x81, payload.length]), payload]));
  } else if (payload.length < 65536) {
    socket.write(Buffer.concat([Buffer.from([0x81, 126, (payload.length >> 8) & 0xff, payload.length & 0xff]), payload]));
  } else {
    const h = Buffer.alloc(10);
    h[0] = 0x81; h[1] = 127;
    const big = Buffer.alloc(8);
    big.writeBigUInt64BE(BigInt(payload.length));
    socket.write(Buffer.concat([h, big, payload]));
  }
}

function proxyStreamToCallbacks(payload, onChunk, onDone) {
  const body = JSON.stringify({ ...payload, stream: true });
  const u = new URL(UPSTREAM + '/v1/chat/completions');
  const r = http.request({
    method: 'POST',
    hostname: u.hostname, port: u.port || 80, path: u.pathname,
    headers: { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(body) },
  }, (resp) => {
    if (resp.statusCode !== 200) { onDone(new Error('upstream ' + resp.statusCode)); return; }
    let buf = '';
    resp.on('data', (chunk) => {
      buf += chunk.toString('utf8');
      let idx;
      while ((idx = buf.indexOf('\n')) !== -1) {
        const line = buf.slice(0, idx).trim();
        buf = buf.slice(idx + 1);
        if (!line.startsWith('data:')) continue;
        const data = line.slice(5).trim();
        if (data === '[DONE]') { onDone(null); return; }
        try {
          const evt = JSON.parse(data);
          const delta = evt.choices && evt.choices[0] && evt.choices[0].delta;
          const text = delta && (delta.content || delta.text || '');
          if (text) onChunk(text);
        } catch (e) { /* ignore parse errors */ }
      }
    });
    resp.on('end', () => { onDone(null); });
    resp.on('error', (e) => { onDone(e); });
  });
  r.on('error', (e) => { onDone(e); });
  r.write(body); r.end();
}

function buildSnapshot() {
  return { sessions: Array.from(SESSIONS.values()).map(s => ({ id: s.id, title: s.title || 'session', createdAt: s.createdAt })) };
}

function handleMethod(socket, msg, ping) {
  const method = msg.method;
  const id = msg.id;
  const params = msg.params || {};

  if (method === 'connect') {
    return {
      type: 'res', id, ok: true,
      payload: {
        type: 'hello-ok', protocol: 4,
        server: { version: '2026.2.21-2', connId: crypto.randomBytes(8).toString('hex') },
        features: {
          methods: ['sessions.list','sessions.send','agent.run','agent.wait','agent.abort','models.list','models.catalog','config.get','channels.status'],
          events: ['session.update','agent.progress','chat.chunk','agent.done'],
        },
        snapshot: buildSnapshot(),
        auth: { role: 'operator', scopes: ['operator.read','operator.write'] },
        policy: { maxPayload: 26214400, maxBufferedBytes: 52428800, tickIntervalMs: 15000 },
      },
    };
  }

  if (method === 'sessions.list') return { type: 'res', id, ok: true, payload: buildSnapshot() };

  if (method === 'sessions.send') {
    const sid = newSessionId();
    const s = { id: sid, title: (params.message || params.text || 'chat').slice(0, 60), createdAt: Date.now(), messages: [] };
    SESSIONS.set(sid, s);
    setImmediate(() => sendFrame(socket, { type: 'event', event: 'session.update', payload: { session: s } }));
    return { type: 'res', id, ok: true, payload: { sessionId: sid } };
  }

  if (method === 'agent.run') {
    const sid = params.sessionId || (SESSIONS.size ? Array.from(SESSIONS.keys()).pop() : null);
    const sess = sid ? SESSIONS.get(sid) : null;
    const userText = params.message || params.text || params.prompt || (sess && sess.messages.length ? sess.messages[sess.messages.length - 1] : '') || '';
    const messages = Array.isArray(params.messages) ? params.messages : [{ role: 'user', content: userText }];
    const modelId = params.model || 'local';
    setImmediate(() => {
      sendFrame(socket, { type: 'event', event: 'agent.progress', payload: { sessionId: sid, state: 'running', model: modelId } });
      if (sess) sess.messages.push(...messages);
      const fullText = { value: '' };
      proxyStreamToCallbacks(
        { model: modelId, messages, max_tokens: 256, temperature: 0.7 },
        (chunk) => {
          fullText.value += chunk;
          sendFrame(socket, { type: 'event', event: 'chat.chunk', payload: { sessionId: sid, delta: chunk, text: fullText.value } });
        },
        (err) => {
          if (err) {
            sendFrame(socket, { type: 'event', event: 'agent.progress', payload: { sessionId: sid, state: 'error', error: String(err.message || err) } });
            sendFrame(socket, { type: 'res', id, ok: false, error: { message: String(err.message || err) } });
            return;
          }
          if (sess) sess.messages.push({ role: 'assistant', content: fullText.value });
          sendFrame(socket, { type: 'event', event: 'agent.progress', payload: { sessionId: sid, state: 'done' } });
          sendFrame(socket, { type: 'event', event: 'agent.done', payload: { sessionId: sid, text: fullText.value } });
          sendFrame(socket, { type: 'res', id, ok: true, payload: { sessionId: sid, text: fullText.value, runId: id } });
        }
      );
    });
    return { type: 'res', id, ok: true, payload: { sessionId: sid, started: true, runId: id } };
  }

  if (method === 'agent.wait' || method === 'agent.abort') return { type: 'res', id, ok: true, payload: { status: 'noop' } };

  if (method === 'models.list' || method === 'models.catalog') {
    return { type: 'res', id, ok: true, payload: { models: [{ id: 'local', name: 'Local (node-llama-cpp)', provider: 'dagestan' }] } };
  }

  if (method === 'config.get') return { type: 'res', id, ok: true, payload: { settings: {} } };

  if (method === 'channels.status' || method === 'channels.list') return { type: 'res', id, ok: true, payload: { channels: [] } };

  return { type: 'res', id, ok: false, error: { message: 'unknown_method: ' + method } };
}

function wsUpgrade(req, socket) {
  const key = req.headers['sec-websocket-key'];
  if (!key) { socket.destroy(); return; }
  const accept = crypto.createHash('sha1').update(key + '258EAFA5-E914-47DA-95CA-5AB9D1168410').digest('base64');
  socket.write(
    'HTTP/1.1 101 Switching Protocols\r\n' +
    'Upgrade: websocket\r\n' +
    'Connection: Upgrade\r\n' +
    'Sec-WebSocket-Accept: ' + accept + '\r\n' +
    '\r\n'
  );
  const ping = setInterval(() => { try { socket.write(Buffer.from([0x89, 0x00])); } catch(e) { clearInterval(ping); } }, 30000);
  let buf = Buffer.alloc(0);
  socket.on('data', (data) => {
    buf = Buffer.concat([buf, data]);
    while (buf.length >= 2) {
      const op = buf[0] & 0x0f;
      const masked = (buf[1] & 0x80) !== 0;
      let len = buf[1] & 0x7f;
      let offset = 2;
      if (len === 126) {
        if (buf.length < 4) return;
        len = buf.readUInt16BE(2); offset = 4;
      } else if (len === 127) {
        if (buf.length < 10) return;
        len = Number(buf.readBigUInt64BE(2)); offset = 10;
      }
      const maskBytes = masked ? 4 : 0;
      const totalNeeded = offset + maskBytes + len;
      if (buf.length < totalNeeded) return;
      let payload = buf.slice(offset + maskBytes, totalNeeded);
      if (masked) {
        const maskKey = buf.slice(offset, offset + 4);
        const unmasked = Buffer.alloc(payload.length);
        for (let i = 0; i < payload.length; i++) unmasked[i] = payload[i] ^ maskKey[i & 3];
        payload = unmasked;
      }
      buf = buf.slice(totalNeeded);
      try {
        if (op === 0x08) { socket.end(); return; }
        if (op === 0x09) { try { socket.write(Buffer.from([0x8a, 0x00])); } catch {} continue; }
        if (op === 0x0a) continue;
        if (op !== 0x01 && op !== 0x02) continue;
        const msg = JSON.parse(payload.toString('utf8'));
        if (msg.type !== 'req') continue;
        const resp = handleMethod(socket, msg, ping);
        sendFrame(socket, resp);
      } catch (e) { log('warn', 'frame error: ' + e.message); }
    }
  });
  socket.on('error', () => { clearInterval(ping); });
  socket.on('close', () => { clearInterval(ping); });
}

// ---- HTTP handler ----
const DAGESTAN_DASH = '<!DOCTYPE html>\n<html lang="en">\n<head>\n<meta charset="utf-8" />\n<meta name="viewport" content="width=device-width,initial-scale=1" />\n<title>Dagestan Dashboard</title>\n<style>\n:root{--bg:#0b0d12;--fg:#e8eaed;--muted:#7b8497;--accent:#38bdf8;--card:#11141b;--border:#1e2230}\n*{box-sizing:border-box;margin:0;padding:0}\nhtml,body{height:100%}\nbody{font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:var(--bg);color:var(--fg);display:flex;align-items:center;justify-content:center;padding:1.5rem}\n.shell{max-width:520px;width:100%;background:var(--card);border:1px solid var(--border);border-radius:14px;padding:1.5rem}\nh1{font-size:1.1rem;font-weight:600;margin-bottom:.25rem}\np{color:var(--muted);font-size:.875rem;line-height:1.5;margin-bottom:1rem}\n.btn{display:inline-flex;align-items:center;gap:.5rem;background:var(--accent);color:#0b0d12;text-decoration:none;padding:.55rem 1rem;border-radius:8px;font-weight:600;font-size:.875rem}\n.btn:hover{filter:brightness(1.1)}\n.kbd{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.75rem;background:#0b0d12;border:1px solid var(--border);padding:.1rem .35rem;border-radius:4px}\n</style>\n</head>\n<body>\n<div class="shell">\n<h1>Dagestan Dashboard</h1>\n<p>This service\'s API is reachable at <span class="kbd">/v1/chat/completions</span>. The unified web dashboard lives on the main Dagestan port.</p>\n<a class="btn" href="http://127.0.0.1:5173/dashboard">Open Dagestan Dashboard &rarr;</a>\n</div>\n</body>\n</html>';
const handler = async (req, res) => {
  _reqCount += 1;
  const u = new URL(req.url, 'http://localhost');
  logActivity(req, u);
  if (req.method === 'OPTIONS') {
    res.writeHead(204, cors());
    return res.end();
  }
  if (req.method === 'GET' && (u.pathname === '/' || u.pathname === '/index.html' || u.pathname === '')) { res.writeHead(200, hdr('text/html')); return res.end(DAGESTAN_DASH); }
  if (u.pathname === '/readyz' || u.pathname === '/healthz') {
    res.writeHead(200, hdr('text/plain'));
    return res.end('ok');
  }
  if (u.pathname === '/api/status') {
    res.writeHead(200, hdr('application/json'));
    return res.end(JSON.stringify({
      status: 'running', port: PORT_MAIN, control: PORT_CTRL,
      uptime: process.uptime(), requests: _reqCount, sessions: SESSIONS.size,
      protocol: 4, version: '2026.2.21-2', name: 'openclaw', brand: 'Dagestan OpenClaw',
    }));
  }
  if (u.pathname === '/v1/models') { res.writeHead(200, hdr('application/json')); return res.end(JSON.stringify({ object: 'list', data: FREE_MODELS })); }
  if (req.method === 'POST' && (u.pathname === '/v1/chat/completions' || u.pathname === '/v1/responses')) {
    const bodyRaw = await readBody(req);
    let payload = {}; try { payload = JSON.parse(bodyRaw || '{}'); } catch { res.writeHead(400, hdr('application/json')); return res.end(JSON.stringify({ error: { message: 'Invalid JSON' } })); }
    const isStream = !!payload.stream;
    const r = routeProxyChat(payload, res, isStream, cors());
    if (r.handled) return;
    // Fall through to local stub if no provider matched
    if (isStream) {
      try { res.writeHead(200, Object.assign({ 'Content-Type': 'text/event-stream; charset=utf-8' }, cors())); } catch {}
      const r2 = http.request({ method: 'POST', hostname: '127.0.0.1', port: 18927, path: '/v1/chat/completions', headers: { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(bodyRaw) } }, (up) => { up.pipe(res); });
      r2.on('error', () => { try { res.write('data: {"error":{"message":"local upstream unavailable"}}\n\ndata: [DONE]\n\n'); res.end(); } catch {} });
      r2.write(bodyRaw); r2.end();
    } else {
      const r2 = http.request({ method: 'POST', hostname: '127.0.0.1', port: 18927, path: '/v1/chat/completions', headers: { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(bodyRaw) } }, (up) => {
        const cs = []; up.on('data', c => cs.push(c)); up.on('end', () => { res.writeHead(up.statusCode || 200, hdr('application/json')); res.end(Buffer.concat(cs).toString('utf8')); });
      });
      r2.on('error', () => { res.writeHead(502, hdr('application/json')); res.end(JSON.stringify({ error: { message: 'local upstream unavailable' } })); });
      r2.write(bodyRaw); r2.end();
    }
    return;
  }
  if (u.pathname === '/api/sessions') {
    res.writeHead(200, hdr('application/json'));
    return res.end(JSON.stringify(buildSnapshot()));
  }
  if (u.pathname === '/api/channels') {
    res.writeHead(200, hdr('application/json'));
    return res.end(JSON.stringify({ channels: [] }));
  }
  if (u.pathname === '/api/logs') {
    res.writeHead(200, hdr('application/json'));
    return res.end(JSON.stringify(_log.slice(0, 100)));
  }
  res.writeHead(200, hdr('text/html'));
  res.end(GW_HTML);
};

function cors() {
  return {
    'Access-Control-Allow-Origin': '*',
    'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
    'Access-Control-Allow-Headers': 'Content-Type, Authorization',
  };
}
function hdr(type) {
  return Object.assign({ 'Content-Type': type + '; charset=utf-8', 'Cache-Control': 'no-cache' }, cors());
}
function logActivity(req, u) {
  if (u.pathname === '/readyz' || u.pathname === '/api/status') return;
  if (req.method === 'GET' && u.pathname === '/') return;
  if (req.url && req.url.length < 200) log('info', req.method + ' ' + u.pathname);
}

// ---- listen: gateway + control UI ----
const gw = http.createServer(handler);
gw.on('upgrade', wsUpgrade);
gw.listen(18790, '0.0.0.0', () => log('info', 'OpenClaw gateway on :18790'));

const ctrl = http.createServer(handler);
ctrl.on('upgrade', wsUpgrade);
ctrl.listen(19002, '0.0.0.0', () => log('info', 'Control UI on :19002'));

process.on('uncaughtException', (e) => { console.error('OpenClaw err:', e.message); });

const GW_HTML = Buffer.from('', 'base64').toString('utf8');