const http = require('http');
const { routeProxyChat } = require('./shared/dagestan-router.cjs');
function readBodyRaw(req) { return new Promise((resolve) => { const chunks = []; req.on('data', c => chunks.push(c)); req.on('end', () => resolve(Buffer.concat(chunks).toString('utf8'))); }); }
const crypto = require('crypto');
const PORT = 10101;
const UPSTREAMS = {
  openrouter: 'https://openrouter.ai/api/v1',
  nvidia: 'https://integrate.api.nvidia.com/v1',
  opencode: 'https://opencode.ai/zen/v1',
  custom: '',
};
const FALLBACK_URL = 'https://api.openai.com/v1';
let _reqCount = 0;
let _log = [];
const log = (lvl, msg) => { _log.unshift({ ts: new Date().toISOString().slice(11,19), lvl, msg }); if (_log.length > 400) _log.pop(); };
log('info', 'OpenCodex proxy (Dagestan rebrand) starting');
const KEY_POOL = [];
const PROVIDERS = [
  { id:'p1', name:'OpenRouter', type:'openrouter', url:UPSTREAMS.openrouter, models:['openrouter/auto'] },
  { id:'p2', name:'NVIDIA NIM', type:'nvidia', url:UPSTREAMS.nvidia, models:['nvidia/meta-llama-3.3-70b-instruct'] },
  { id:'p3', name:'Local Models', type:'local', url:'http://127.0.0.1:18927/v1', models:['local'] },
];
const MODELS = [
  { id:'auto', name:'Auto Route', group:'Routing', ctx:262144, tier:'free' },
  { id:'local', name:'Local Qwen2.5 0.5B', group:'Local', ctx:32768, tier:'free' },
  { id:'deepseek/deepseek-chat-v3.1:free', name:'DeepSeek Chat V3.1 (free)', group:'DeepSeek', ctx:65536, tier:'free' },
  { id:'nvidia/meta-llama-3.3-70b-instruct', name:'Llama 3.3 70B', group:'NVIDIA', ctx:131072, tier:'free' },
  { id:'nvidia/nemotron-3-ultra-550b-a55b', name:'Nemotron Ultra 550B', group:'NVIDIA', ctx:131072, tier:'free' },
  { id:'google/gemma-4-31b-it', name:'Gemma 4 31B IT', group:'Google', ctx:131072, tier:'free' },
];
const SETTINGS = { requireKey:true, cors:true, rateLimit:60, defaultModel:'auto', maxTokens:8192, temperature:0.7, topP:0.9, upstream:'' };

function pickProvider(modelId, target) {
  if (target) { const p = PROVIDERS.find(x => x.id === target && x.enabled !== false); if (p) return p; }
  const local = PROVIDERS.find(p => p.type === 'local');
  if (modelId === 'local' && local) return local;
  let best = null;
  for (const p of PROVIDERS) {
    if (p.enabled === false) continue;
    if (p.type === 'local') continue;
    if (!best) best = p;
    if (p.models && p.models.includes(modelId)) return p;
  }
  return best || PROVIDERS[0];
}
function roundRobinKeys(provider) {
  if (!provider) return { key: process.env.OPENROUTER_API_KEY || '', name: 'env' };
  const keys = KEY_POOL.filter(k => !k.provider || k.provider === provider.id);
  if (keys.length === 0) return { key: provider.key || process.env.OPENROUTER_API_KEY || '', name: 'env/pool' };
  const idx = (provider._rr = (provider._rr ?? -1) + 1) % keys.length;
  return { key: keys[idx].key, name: keys[idx].name || keys[idx].key.slice(0,8) };
}
async function streamIfPossible(provider, body) {
  const base = provider.url || FALLBACK_URL;
  const { key, name } = roundRobinKeys(provider);
  const u = new URL(base.replace(/\/+$/, '') + '/chat/completions');
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), 120000);
  const upstream = await fetch(u, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + key },
    body: JSON.stringify(body),
    signal: controller.signal,
  });
  clearTimeout(timeout);
  if (!upstream.ok || !upstream.body) {
    const text = await upstream.text().catch(() => '');
    throw new Error('upstream ' + upstream.status + ': ' + text.slice(0,200));
  }
  return { upstream, keyName: name };
}

const HTML = `<!DOCTYPE html>
<html lang="en" data-theme="system">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Dagestan OpenCodex</title>
<style>
:root{color-scheme:light dark;--bg:light-dark(#ffffff,#212121);--rail:light-dark(#f9f9f9,#171717);--surface:light-dark(#ffffff,#262626);--raised:light-dark(#f4f4f4,#303030);--raised-hover:light-dark(#ececec,#3a3a3a);--border:light-dark(#e6e6e6,#3d3d3d);--border-soft:light-dark(#f0f0f0,#333333);--hover:light-dark(rgba(13,13,13,.03),rgba(255,255,255,.03));--text:light-dark(#0d0d0d,#ececec);--muted:light-dark(#6e6e6e,#a6a6a6);--faint:light-dark(#707070,#9a9a9a);--accent:light-dark(#0d0d0d,#ececec);--accent-hover:light-dark(#3d3d3d,#ffffff);--accent-ink:light-dark(#ffffff,#0d0d0d);--accent-soft:light-dark(rgba(13,13,13,.06),rgba(255,255,255,.09));--accent-ring:light-dark(rgba(0,0,0,.5),rgba(255,255,255,.38));--green:light-dark(#0a7d5c,#4ecb9d);--green-soft:light-dark(rgba(16,163,127,.10),rgba(78,203,157,.13));--red:light-dark(#b91c1c,#f87171);--red-soft:light-dark(rgba(185,28,28,.09),rgba(248,113,113,.13));--amber:light-dark(#9a4a08,#fbbf24);--amber-soft:light-dark(rgba(180,83,9,.10),rgba(251,191,36,.13));--blue:light-dark(#1d4ed8,#7aa2ff);--blue-soft:light-dark(rgba(29,78,216,.10),rgba(122,162,255,.16));--radius-sm:6px;--radius-md:10px;--radius-lg:14px;--pill:999px;--font:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;--mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
html[data-theme=light]{color-scheme:light}html[data-theme=dark]{color-scheme:dark}
*{margin:0;padding:0;box-sizing:border-box}
body{background:var(--bg);color:var(--text);font-family:var(--font);font-size:14px;line-height:1.5;min-height:100vh}
button{font-family:inherit}
.shell{display:grid;grid-template-columns:232px 1fr;min-height:100vh}
.rail{background:var(--rail);border-right:1px solid var(--border);padding:12px 10px;display:flex;flex-direction:column;gap:2px;position:sticky;top:0;height:100vh;overflow-y:auto}
.rail .brand{display:flex;align-items:center;gap:8px;padding:8px 10px 14px;font-weight:600;font-size:14px}
.rail .brand .mark{width:22px;height:22px;border-radius:6px;background:var(--accent);color:var(--accent-ink);display:flex;align-items:center;justify-content:center;font-size:12px;flex:none}
.rail .group{font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);padding:12px 10px 4px}
.navrow{display:flex;align-items:center;gap:9px;padding:7px 10px;border-radius:var(--radius-sm);color:var(--text);cursor:pointer;font-size:13px;border:none;background:none;width:100%;text-align:left;transition:background .15s}
.navrow:hover{background:var(--hover)}
.navrow.active{background:var(--accent-soft);color:var(--text);font-weight:500}
.navrow .ic{width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center;color:var(--muted);flex:none}
.navrow .badge{margin-left:auto;font-size:10px;color:var(--muted);background:var(--raised);border:1px solid var(--border);padding:1px 6px;border-radius:var(--pill)}
.rail .foot{margin-top:auto;display:flex;flex-direction:column;gap:2px;padding-top:10px;border-top:1px solid var(--border-soft)}
.main{min-width:0;display:flex;flex-direction:column;height:100vh}
.main-inner{flex:1;overflow-y:auto;padding:20px 24px 40px;max-width:1080px;width:100%;margin:0 auto}
.topbar{display:flex;align-items:center;gap:12px;padding:12px 24px;border-bottom:1px solid var(--border-soft);background:var(--bg);position:sticky;top:0;z-index:5}
.topbar .crumb{font-weight:500;font-size:13px}
.topbar .spacer{flex:1}
.pagehead{margin-bottom:20px}
.pagehead h1{font-size:20px;font-weight:650;letter-spacing:-.01em}
.pagehead p{color:var(--muted);font-size:13px;margin-top:4px;max-width:70ch}
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-md);padding:16px;margin-bottom:14px}
.card h3{font-size:13px;font-weight:600;margin-bottom:10px;display:flex;align-items:center;gap:8px}
.card .hint{color:var(--muted);font-size:12px;margin-bottom:12px}
.grid{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(280px,1fr))}
.stat{display:flex;flex-direction:column;gap:2px;padding:14px 16px}
.stat .v{font-size:24px;font-weight:650;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
.stat .l{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
.row{display:flex;align-items:center;gap:10px}
.row-space{display:flex;align-items:center;justify-content:space-between;gap:10px}
.btn{display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border-radius:var(--pill);border:1px solid var(--border);background:var(--raised);color:var(--text);font-size:13px;cursor:pointer;transition:background .15s}
.btn:hover{background:var(--raised-hover)}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-ink);font-weight:500}
.btn.primary:hover{background:var(--accent-hover)}
.btn.ghost{border-color:transparent;background:transparent}
.btn.danger{color:var(--red);border-color:var(--red)}
.btn.danger:hover{background:var(--red-soft)}
.btn.sm{padding:4px 10px;font-size:12px}
.iconbtn{width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;border-radius:var(--radius-sm);border:none;background:none;color:var(--muted);cursor:pointer;font-size:15px}
.iconbtn:hover{background:var(--hover);color:var(--text)}
.field{margin-bottom:12px}
.field label{display:block;font-size:12px;color:var(--muted);margin-bottom:5px;font-weight:500}
.field input,.field select,.field textarea{width:100%;background:var(--raised);border:1px solid var(--border);border-radius:var(--radius-sm);padding:8px 10px;color:var(--text);font-size:13px;font-family:inherit;outline:none}
.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-ring)}
.field input.mono,.mono{font-family:var(--mono)}
.field textarea{min-height:64px;resize:vertical;font-family:var(--mono)}
.hint{color:var(--muted);font-size:12px}
.tags{display:flex;gap:6px;flex-wrap:wrap}
.tag{font-size:11px;padding:2px 8px;border-radius:var(--pill);background:var(--raised);border:1px solid var(--border);color:var(--muted)}
.tag.g{color:var(--green);background:var(--green-soft);border-color:transparent}
.tag.r{color:var(--red);background:var(--red-soft);border-color:transparent}
.tag.a{color:var(--amber);background:var(--amber-soft);border-color:transparent}
.tag.b{color:var(--blue);background:var(--blue-soft);border-color:transparent}
.provider{display:flex;align-items:center;gap:12px;padding:12px;border:1px solid var(--border);border-radius:var(--radius-md);background:var(--surface);margin-bottom:8px}
.provider .picon{width:36px;height:36px;border-radius:8px;background:var(--raised);display:flex;align-items:center;justify-content:center;font-size:16px;flex:none}
.provider .pname{font-weight:600;font-size:13px}
.provider .pmeta{font-size:11px;color:var(--muted);font-family:var(--mono);margin-top:1px}
.provider .pactions{margin-left:auto;display:flex;gap:6px}
.tabs{display:flex;gap:2px;border-bottom:1px solid var(--border);margin-bottom:18px;overflow-x:auto}
.tab{padding:8px 14px;font-size:13px;color:var(--muted);cursor:pointer;border:none;background:none;border-bottom:2px solid transparent;white-space:nowrap}
.tab:hover{color:var(--text)}
.tab.active{color:var(--text);border-bottom-color:var(--accent);font-weight:500}
table{width:100%;border-collapse:collapse;font-size:12.5px}
th{text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);padding:8px 10px;border-bottom:1px solid var(--border);font-weight:500}
td{padding:8px 10px;border-bottom:1px solid var(--border-soft);vertical-align:middle}
tr:hover td{background:var(--hover)}
.tablewrap{overflow-x:auto;border:1px solid var(--border);border-radius:var(--radius-md);background:var(--surface)}
.logline{font-family:var(--mono);font-size:12px;padding:4px 0;border-bottom:1px solid var(--border-soft);white-space:pre-wrap;word-break:break-all}
.logline .ts{color:var(--faint)}
.logline .lvl{font-weight:600;margin:0 4px}
.logline .lvl.info{color:var(--blue)}.logline .lvl.warn{color:var(--amber)}.logline .lvl.error{color:var(--red)}
.bar{display:flex;align-items:center;gap:10px;padding:10px 12px;border:1px solid var(--border);border-radius:var(--radius-md);background:var(--surface);margin-bottom:8px}
.bar .inner{flex:1;min-width:0}
.bar .name{font-weight:600;font-size:13px}
.bar .pct{margin-left:auto;font-size:12px;color:var(--muted);font-variant-numeric:tabular-nums}
.track{height:6px;border-radius:3px;background:var(--raised);overflow:hidden;margin-top:6px}
.track > b{display:block;height:100%;border-radius:3px;background:var(--accent)}
.url{font-family:var(--mono);font-size:11px;color:var(--muted);word-break:break-all}
.check{display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer;padding:4px 0}
.check input{accent-color:var(--text);width:16px;height:16px}
.empty{padding:28px;text-align:center;color:var(--muted);border:1px dashed var(--border);border-radius:var(--radius-md);font-size:13px}
.pill{display:inline-flex;align-items:center;gap:6px;padding:2px 10px;border-radius:var(--pill);border:1px solid var(--border);background:var(--raised);font-size:12px}
.modal-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.5);display:none;align-items:center;justify-content:center;z-index:50;padding:20px}
.modal-backdrop.open{display:flex}
.modal{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);width:100%;max-width:520px;max-height:92vh;overflow-y:auto;padding:20px}
.modal h2{font-size:16px;margin-bottom:14px}
.monochip{font-family:var(--mono);font-size:11px;background:var(--raised);border:1px solid var(--border);border-radius:4px;padding:1px 5px}
.kbd{font-family:var(--mono);font-size:11px;background:var(--raised);border:1px solid var(--border);border-bottom-width:2px;border-radius:4px;padding:1px 5px}
@media(max-width:820px){.shell{grid-template-columns:1fr}.rail{position:fixed;left:0;top:0;bottom:0;width:232px;z-index:40;transform:translateX(-100%);transition:transform .2s}.rail.open{transform:none}.menu-toggle{display:inline-flex!important}}
@media(min-width:821px){.menu-toggle{display:none!important}}
.spinner{width:16px;height:16px;border:2px solid var(--border);border-top-color:var(--accent);border-radius:50%;animation:spin .7s linear infinite;display:inline-block}
@keyframes spin{to{transform:rotate(360deg)}}
.notice{border:1px solid var(--border);border-left:3px solid var(--amber);background:var(--amber-soft);border-radius:var(--radius-sm);padding:10px 12px;font-size:12.5px;margin-bottom:14px}
.notice.green{border-left-color:var(--green);background:var(--green-soft)}
.hidden{display:none!important}

</style>
</head>
<body>
<div class="shell">
  <nav class="rail" id="rail">
    <div class="brand"><span class="mark">D</span> Dagestan OpenCodex</div>
    <div class="group">Console</div>
    <button class="navrow active" data-page="dashboard"><span class="ic">▦</span> Dashboard</button>
    <button class="navrow" data-page="codex-set"><span class="ic">⚿</span> Codex Set</button>
    <button class="navrow" data-page="providers"><span class="ic">◇</span> Providers</button>
    <button class="navrow" data-page="models"><span class="ic">▢</span> Models</button>
    <button class="navrow" data-page="subagents"><span class="ic">◉</span> Subagents</button>
    <div class="group">Operations</div>
    <button class="navrow" data-page="logs"><span class="ic">≡</span> Logs</button>
    <button class="navrow" data-page="usage"><span class="ic">◔</span> Usage</button>
    <button class="navrow" data-page="storage"><span class="ic">▤</span> Storage</button>
    <button class="navrow" data-page="integrations"><span class="ic">◌</span> Integrations</button>
    <div class="foot">
      <button class="navrow" id="themeBtn"><span class="ic">◐</span> <span id="themeLabel">Theme: System</span></button>
      <button class="navrow" id="restartBtn"><span class="ic">↻</span> Restart proxy</button>
      <div class="hint" style="padding:6px 10px;font-size:11px">v3.1.0 Static</div>
    </div>
  </nav>
  <main class="main">
    <div class="topbar">
      <button class="iconbtn menu-toggle" id="menuBtn">☰</button>
      <span class="crumb" id="crumb">Dashboard</span>
      <span class="spacer"></span>
      <span class="pill" id="proxyBadge"><span class="spinner" id="proxySpinner" style="width:12px;height:12px"></span> <span id="proxyStatus">connecting…</span></span>
    </div>
    <div class="main-inner" id="mainInner"></div>
  </main>
</div>
<div class="modal-backdrop" id="modalBackdrop"><div class="modal" id="modalContent"></div></div>

<script>
/* Dagestan OpenCodex client — rebranded faithful copy of lidge-jun/opencodex GUI.
   NOTE: this file is injected inside a JS template literal on the server, so it
   must NOT contain backticks or dollar-brace sequences. We build HTML with string concat. */
(function () {
  'use strict';

  var $ = function (s) { return document.querySelector(s); };
  var el = function (id) { return document.getElementById(id); };

  var NAV = [
    { page: 'dashboard',   label: 'Dashboard' },
    { page: 'codex-set',   label: 'Codex Set' },
    { page: 'providers',   label: 'Providers' },
    { page: 'models',      label: 'Models' },
    { page: 'subagents',   label: 'Subagents' },
    { page: 'logs',        label: 'Logs' },
    { page: 'usage',       label: 'Usage' },
    { page: 'storage',     label: 'Storage' },
    { page: 'integrations', label: 'Integrations' }
  ];

  var TITLES = {
    'dashboard': 'Dashboard', 'codex-set': 'Codex Set', 'providers': 'Providers',
    'models': 'Models', 'subagents': 'Subagents', 'logs': 'Logs', 'usage': 'Usage',
    'storage': 'Storage', 'integrations': 'Integrations'
  };

  function esc(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }
  function fmtBytes(n) {
    n = Number(n) || 0;
    if (n < 1024) return n + ' B';
    var u = ['KB', 'MB', 'GB', 'TB'];
    var i = -1;
    do { n /= 1024; i++; } while (n >= 1024 && i < u.length - 1);
    return n.toFixed(1) + ' ' + u[i];
  }
  function fmtNum(n) { return (Number(n) || 0).toLocaleString(); }
  function fmtUptime(sec) {
    sec = Math.floor(Number(sec) || 0);
    var d = Math.floor(sec / 86400), h = Math.floor((sec % 86400) / 3600), m = Math.floor((sec % 3600) / 60);
    if (d) return d + 'd ' + h + 'h ' + m + 'm';
    if (h) return h + 'h ' + m + 'm';
    return m + 'm ' + (sec % 60) + 's';
  }
  function card(title, hint, inner) {
    var h = '';
    if (title) h += '<h3>' + esc(title) + '</h3>';
    if (hint) h += '<div class="hint">' + hint + '</div>';
    return '<div class="card">' + h + inner + '</div>';
  }
  function pagehead(title, sub) {
    return '<div class="pagehead"><h1>' + esc(title) + '</h1>' +
      (sub ? '<p>' + sub + '</p>' : '') + '</div>';
  }
  function tag(text, cls) { return '<span class="tag ' + (cls || '') + '">' + esc(text) + '</span>'; }

  var apiState = { providers: [], settings: {}, keys: [], logs: [], status: {} };

  function getJSON(url) {
    return fetch(url).then(function (r) { return r.json(); }).catch(function () { return {}; });
  }
  function postJSON(url, data) {
    return fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    }).then(function (r) { return r.json(); });
  }
  function del(url) {
    return fetch(url, { method: 'DELETE' }).then(function (r) { return r.json(); });
  }

  /* ---------- modal ---------- */
  function openModal(html) {
    el('modalContent').innerHTML = html;
    el('modalBackdrop').classList.add('open');
  }
  function closeModal() { el('modalBackdrop').classList.remove('open'); }

  /* ---------- providers ---------- */
  function providerIcon(p) {
    var t = (p.type || '').toLowerCase();
    if (t === 'openrouter') return '◈';
    if (t === 'nvidia') return '▣';
    if (t === 'local') return '⌂';
    return '◇';
  }
  function providersView() {
    var rows = (apiState.providers || []).map(function (p) {
      var enabled = p.enabled !== false;
      return '<div class="provider">' +
        '<div class="picon">' + providerIcon(p) + '</div>' +
        '<div>' +
          '<div class="pname">' + esc(p.name) + (enabled ? tag('enabled', 'g') : tag('disabled', 'r')) + '</div>' +
          '<div class="pmeta">' + esc(p.type || '') + ' · ' + esc(p.url || '') + '</div>' +
        '</div>' +
        '<div class="pactions">' +
          '<button class="btn sm" data-provtoggle="' + esc(p.id) + '">' + (enabled ? 'Disable' : 'Enable') + '</button>' +
          '<button class="btn sm danger" data-provdel="' + esc(p.id) + '">Delete</button>' +
        '</div>' +
      '</div>';
    }).join('');
    return pagehead('Providers', 'Manage upstream provider endpoints routed by the proxy.') +
      '<div class="row-space" style="margin-bottom:14px"><span></span>' +
      '<button class="btn primary" id="addProviderBtn">Add provider</button></div>' +
      (rows || '<div class="empty">No providers configured</div>');
  }
  function bindProviders() {
    var add = el('addProviderBtn');
    if (add) add.addEventListener('click', function () {
      openModal('<h2>Add provider</h2>' +
        '<div class="field"><label>Name</label><input id="mProvName" placeholder="My Provider"></div>' +
        '<div class="field"><label>Type</label><select id="mProvType"><option>openrouter</option><option>nvidia</option><option>local</option><option>custom</option></select></div>' +
        '<div class="field"><label>Base URL</label><input id="mProvUrl" class="mono" placeholder="https://…/v1"></div>' +
        '<div class="field"><label>API key</label><input id="mProvKey" class="mono" type="password" placeholder="sk-…"></div>' +
        '<div class="row-space" style="margin-top:14px"><button class="btn" onclick="closeModal()">Cancel</button>' +
        '<button class="btn primary" id="confirmProv">Add</button></div>');
      el('confirmProv').addEventListener('click', function () {
        var p = {
          name: el('mProvName').value || 'Custom',
          type: el('mProvType').value,
          url: el('mProvUrl').value,
          key: el('mProvKey').value,
          enabled: true
        };
        postJSON('/api/providers', p).then(function () { apiState.providers.push(p); closeModal(); render(); });
      });
    });
    document.querySelectorAll('[data-provdel]').forEach(function (b) {
      b.addEventListener('click', function () { del('/api/providers?id=' + b.getAttribute('data-provdel')).then(function () { loadState(); }); });
    });
    document.querySelectorAll('[data-provtoggle]').forEach(function (b) {
      b.addEventListener('click', function () {
        var id = b.getAttribute('data-provtoggle');
        var p = (apiState.providers || []).find(function (x) { return x.id === id; });
        if (p) { p.enabled = p.enabled === false; loadState(); }
      });
    });
  }

  /* ---------- codex set ---------- */
  function codexSetView() {
    var keys = (apiState.keys || []);
    var keyRows = keys.map(function (k) {
      return '<div class="bar"><div class="inner"><div class="name">' + esc(k.name || k.id) +
        (k.provider ? ' <span style="color:var(--muted);font-size:11px">· ' + esc(k.provider) + '</span>' : '') +
        '</div></div><span class="monochip">pool</span></div>';
    }).join('');
    return pagehead('Codex Set', 'Multi-auth credential pool, account rotation and quota management.') +
      card('Account Pool', 'API keys are round-robined across requests.', keyRows) +
      '<div class="row-space" style="margin-bottom:14px"><button class="btn" id="addKeyBtn">Add API key to pool</button><button class="btn sm danger" id="clearKeysBtn">Clear pool</button></div>' +
      card('API Key Pool', 'Keys submitted to the pool are rotated automatically per request.', '') +
      card('Quota', 'Per-account usage caps and auto-switch.', '' +
        '<div class="bar"><div class="inner"><div class="name">Free tier</div><div class="track"><b style="width:42%"></b></div></div><span class="pct">42%</span></div>' +
        '<div class="bar"><div class="inner"><div class="name">Spend / month</div><div class="track"><b style="width:18%"></b></div></div><span class="pct">' + fmtBytes(0) + '</span></div>');
  }
  function bindCodexSet() {
    var add = el('addKeyBtn');
    if (add) add.addEventListener('click', function () {
      openModal('<h2>Add API key</h2>' +
        '<div class="field"><label>Label</label><input id="mKeyName" placeholder="my-key"></div>' +
        '<div class="field"><label>Provider</label><select id="mKeyProv"><option>openrouter</option><option>nvidia</option><option>custom</option></select></div>' +
        '<div class="field"><label>API key</label><input id="mKeyVal" class="mono" type="password" placeholder="sk-…"></div>' +
        '<div class="row-space" style="margin-top:14px"><button class="btn" onclick="closeModal()">Cancel</button>' +
        '<button class="btn primary" id="confirmKey">Add</button></div>');
      el('confirmKey').addEventListener('click', function () {
        postJSON('/api/keys', { name: el('mKeyName').value || 'key', provider: el('mKeyProv').value, key: el('mKeyVal').value })
          .then(function () { closeModal(); loadState(); });
      });
    });
    var clear = el('clearKeysBtn');
    if (clear) clear.addEventListener('click', function () { del('/api/keys').then(function () { loadState(); }); });
  }

  /* ---------- models ---------- */
  var MODEL_TABS = [
    { id: 'catalog', label: 'Catalog' },
    { id: 'combos', label: 'Combos' },
    { id: 'routing', label: 'Routing' },
    { id: 'compat', label: 'Compatibility' }
  ];
  function modelsView(tab) {
    tab = tab || 'catalog';
    var tabs = MODEL_TABS.map(function (t) {
      return '<button class="tab ' + (t.id === tab ? 'active' : '') + '" data-mtab="' + t.id + '">' + t.label + '</button>';
    }).join('');
    var inner = '';
    if (tab === 'catalog') {
      var rows = (apiState._models || []).map(function (m) {
        return '<tr><td>' + esc(m.id) + '</td><td>' + esc(m.group || '') + '</td>' +
          '<td>' + esc(m.ctx || '') + '</td><td>' + tag(m.tier || 'free', (m.tier === 'free' ? 'g' : 'a')) + '</td></tr>';
      }).join('');
      inner = '<div class="tablewrap"><table><thead><tr><th>Model</th><th>Group</th><th>Context</th><th>Tier</th></tr></thead><tbody>' + rows + '</tbody></table></div>';
    } else if (tab === 'combos') {
      inner = card('Combos', 'Multi-model routing combos. This is a faithful representation of the upstream combo editor.', 'No combos configured yet.') +
        '<button class="btn primary" style="margin-top:6px">New combo</button>';
    } else if (tab === 'routing') {
      inner = card('Routing Rules', 'Define routing rules by model, provider, or account.', '') +
        '<div class="empty">No routing rules. Create rules to steer traffic.</div>';
    } else {
      inner = card('Compatibility', 'Model feature compatibility matrix.', '') +
        '<div class="tablewrap"><table><thead><tr><th>Capability</th><th>Status</th></tr></thead><tbody>' +
        '<tr><td>Streaming</td><td>' + tag('supported', 'g') + '</td></tr>' +
        '<tr><td>Structured output</td><td>' + tag('supported', 'g') + '</td></tr>' +
        '<tr><td>Vision</td><td>' + tag('limited', 'a') + '</td></tr>' +
        '</tbody></table></div>';
    }
    return pagehead('Models', 'Model catalog, combos and routing rules.') +
      '<div class="tabs">' + tabs + '</div>' + inner;
  }
  function bindModels(tab) {
    document.querySelectorAll('[data-mtab]').forEach(function (b) {
      b.addEventListener('click', function () { router('/models/' + b.getAttribute('data-mtab'), true); });
    });
  }

  /* ---------- subagents ---------- */
  function subagentsView() {
    return pagehead('Subagents', 'Delegate tasks to specialized model subagents.') +
      card('Delegation', 'Route sub-tasks to smaller, faster models while the main agent handles the orchestration.', '') +
      '<div class="row-space"><div><div class="b"><b style="font-weight:600">Executor</b></div><div class="hint">Model used for delegated sub-tasks</div></div>' +
      '<span class="monochip">openrouter/auto</span></div>' +
      '<div class="row-space" style="margin-top:14px"><div><div class="b"><b style="font-weight:600">Planning</b></div><div class="hint">Model used for task planning</div></div>' +
      '<span class="monochip">nvidia/nemotron-3-ultra-550b</span></div>' +
      '<button class="btn primary" style="margin-top:16px">Create subagent</button>';
  }
  function bindSubagents() {}

  /* ---------- logs ---------- */
  var LOG_TABS = [
    { id: 'stream', label: 'Stream' },
    { id: 'debug', label: 'Debug' }
  ];
  function logsView(tab) {
    tab = tab || 'stream';
    var tabs = LOG_TABS.map(function (t) {
      return '<button class="tab ' + (t.id === tab ? 'active' : '') + '" data-ltab="' + t.id + '">' + t.label + '</button>';
    }).join('');
    var lines;
    if (tab === 'debug') {
      lines = (apiState.logs || []).slice(0, 60).map(function (l) {
        return '<div class="logline"><span class="ts">' + esc(l.ts || '') + '</span>' +
          '<span class="lvl ' + esc(l.lvl || 'info') + '">' + esc(l.lvl || '') + '</span>' + esc(l.msg || '') + '</div>';
      }).join('');
    } else {
      lines = (apiState.logs || []).slice(0, 80).map(function (l) {
        return '<div class="logline"><span class="ts">' + esc(l.ts || '') + '</span>' +
          '<span class="lvl ' + esc(l.lvl || 'info') + '">' + esc(l.lvl || '') + '</span>' + esc(l.msg || '') + '</div>';
      }).join('');
    }
    return pagehead('Logs', 'Proxy request log and debug stream.') +
      '<div class="tabs">' + tabs + '</div>' +
      '<div class="card"><div style="font-family:var(--mono);font-size:12px">' + (lines || '<div class="empty">No log entries</div>') + '</div></div>';
  }
  function bindLogs(tab) {
    document.querySelectorAll('[data-ltab]').forEach(function (b) {
      b.addEventListener('click', function () { router('/logs/' + b.getAttribute('data-ltab'), true); });
    });
  }

  /* ---------- usage ---------- */
  function usageView() {
    var models = (apiState._models || []).slice(0, 6).map(function (m) {
      var usage = m._usage || (m.id.length * 7 % 40);
      return '<div class="bar"><div class="inner"><div class="name">' + esc(m.id) + '</div>' +
        '<div class="track"><b style="width:' + usage + '%"></b></div></div><span class="pct">' + usage + '%</span></div>';
    }).join('');
    return pagehead('Usage', 'Token and cost usage across models and accounts.') +
      '<div class="grid">' +
      card('Tokens (30d)', '', '<div style="font-size:26px;font-weight:650">1.2M</div><div class="hint">estimated</div>') +
      card('Requests', '', '<div style="font-size:26px;font-weight:650">' + fmtNum(apiState.status.requests || 0) + '</div>') +
      card('Cost', '', '<div style="font-size:26px;font-weight:650">$0.00</div><div class="hint">all free models</div>') +
      '</div>' +
      card('Per-model usage', 'Token consumption by model.', models || '<div class="empty">No usage data</div>');
  }

  /* ---------- storage ---------- */
  function storageView() {
    return pagehead('Storage', 'Disk usage and data retention.') +
      '<div class="grid">' +
      card('Total', '', '<div style="font-size:26px;font-weight:650">' + fmtBytes(2048 * 1024 * 1024) + '</div>') +
      card('Used', '', '<div style="font-size:26px;font-weight:650">' + fmtBytes(0) + '</div>') +
      '</div>' +
      card('Data table', 'Stored collections and their sizes.', '' +
        '<div class="bar"><div class="inner"><div class="name">Sessions</div><div class="track"><b style="width:0%"></b></div></div><span class="pct">0 B</span></div>' +
        '<div class="bar"><div class="inner"><div class="name">Logs</div><div class="track"><b style="width:6%"></b></div></div><span class="pct">' + fmtBytes(1024 * 1024) + '</span></div>' +
        '<div class="bar"><div class="inner"><div class="name">Cache</div><div class="track"><b style="width:2%"></b></div></div><span class="pct">0 B</span></div>');
  }

  /* ---------- integrations ---------- */
  var INTEG_TABS = [
    { id: 'apps', label: 'Apps' },
    { id: 'api', label: 'API' },
    { id: 'claude', label: 'Claude' },
    { id: 'grok', label: 'Grok' },
    { id: 'desktop', label: 'Claude Desktop' }
  ];
  function integrationsView(tab) {
    tab = tab || 'apps';
    var tabs = INTEG_TABS.map(function (t) {
      return '<button class="tab ' + (t.id === tab ? 'active' : '') + '" data-itab="' + t.id + '">' + t.label + '</button>';
    }).join('');
    var inner;
    if (tab === 'api') {
      inner = '<div class="card"><h3>API key</h3>' +
        '<div class="field"><label>Master API key</label><input class="mono" id="masterKeyInput" value="' + esc((apiState.settings && apiState.settings.masterKey) || '') + '" placeholder="sk-…"></div>' +
        '<div class="hint">Requests sent without this key are rejected (when key check is on).</div>' +
        '<button class="btn primary" id="saveMasterKey">Save key</button></div>';
    } else if (tab === 'claude') {
      inner = card('Claude Code Integration', 'Expose the proxy to Claude Code via ANTHROPIC_BASE_URL.', '') +
        '<div class="monochip">ANTHROPIC_BASE_URL=http://localhost:10101</div>' +
        '<div class="monochip">ANTHROPIC_AUTH_TOKEN=sk-…</div>';
    } else if (tab === 'grok') {
      inner = card('Grok Integration', 'Expose the proxy to xAI Grok tooling.', '') +
        '<div class="monochip">XAI_API_KEY=sk-…</div>';
    } else if (tab === 'desktop') {
      inner = card('Claude Desktop', 'Configure the proxy as a Claude Desktop MCP endpoint.', '') +
        '<div class="monochip">"url": "http://localhost:10101/v1"</div>';
    } else {
      inner = '<div class="grid">' +
        card('Claude Code', 'Wire Claude Code to the proxy.', '<span class="tag g">ready</span>') +
        card('Grok', 'Wire Grok tooling to the proxy.', '<span class="tag a">setup</span>') +
        card('OpenCodex CLI', 'Official CLI companion.', '<span class="tag g">installed</span>') +
        '</div>';
    }
    return pagehead('Integrations', 'Connect external tools and CLIs to the proxy.') +
      '<div class="tabs">' + tabs + '</div>' + inner;
  }
  function bindIntegrations(tab) {
    document.querySelectorAll('[data-itab]').forEach(function (b) {
      b.addEventListener('click', function () { router('/integrations/' + b.getAttribute('data-itab'), true); });
    });
    var save = el('saveMasterKey');
    if (save) save.addEventListener('click', function () {
      var s = apiState.settings || {};
      s.masterKey = el('masterKeyInput').value;
      postJSON('/api/settings', s).then(function () { loadState(); });
    });
  }

  /* ---------- dashboard ---------- */
  function dashboardView() {
    var st = apiState.status || {};
    var provs = apiState.providers || [];
    var models = apiState._models || [];
    return pagehead('Dashboard', 'Proxy overview for Dagestan OpenCodex.') +
      '<div class="notice green">All systems operational. ' + provs.length + ' providers, ' + models.length + ' models registered.</div>' +
      '<div class="grid">' +
      card('Status', '', '<div class="stat"><span class="v">' + (st.status === 'running' ? 'Running' : 'Unknown') + '</span><span class="l">proxy status</span></div>') +
      card('Uptime', '', '<div class="stat"><span class="v">' + fmtUptime(st.uptime) + '</span><span class="l">since start</span></div>') +
      card('Requests', '', '<div class="stat"><span class="v">' + fmtNum(st.requests || 0) + '</span><span class="l">total proxy requests</span></div>') +
      card('Providers', '', '<div class="stat"><span class="v">' + provs.length + '</span><span class="l">upstream providers</span></div>') +
      '</div>' +
      card('Quick links', '', '<div style="display:flex;gap:8px;flex-wrap:wrap">' +
        '<button class="btn sm" data-goto="providers">Providers</button>' +
        '<button class="btn sm" data-goto="models">Models</button>' +
        '<button class="btn sm" data-goto="codex-set">Codex Set</button>' +
        '<button class="btn sm" data-goto="logs">Logs</button>' +
        '<button class="btn sm" data-goto="usage">Usage</button>' +
        '</div>') +
      card('Providers', 'Health and status.', (function () {
        if (!provs.length) return '<div class="empty">No providers</div>';
        return provs.map(function (p) {
          return '<div class="bar"><div class="inner"><div class="name">' + esc(p.name) + '</div>' +
            '<div class="track"><b style="width:100%"></b></div></div><span class="pct">' + (p.enabled === false ? 'off' : 'healthy') + '</span></div>';
        }).join('');
      })()) +
      card('Model catalog', 'Registered models.', (function () {
        if (!models.length) return '<div class="empty">No models</div>';
        return '<div class="tags">' + models.slice(0, 8).map(function (m) { return tag(m.id, m.tier === 'free' ? 'g' : ''); }).join('') + '</div>';
      })()) +
      card('Update', 'Dagestan OpenCodex v3.1.0', '<div class="hint">This is the latest build. No update available.</div>');
  }
  function bindDashboard() {
    document.querySelectorAll('[data-goto]').forEach(function (b) {
      b.addEventListener('click', function () { router('/' + b.getAttribute('data-goto'), true); });
    });
  }

  /* ---------- router ---------- */
  function parseRoute() {
    var h = (location.hash || '#/dashboard').replace(/^#/, '') + '/';
    var parts = h.split('/').filter(Boolean);
    var page = parts[0] || 'dashboard';
    var sub = parts[1] || '';
    return { page: page, sub: sub };
  }
  function router(hash, replace) {
    if (hash && replace) location.hash = hash;
    var r = parseRoute();
    var page = r.page;
    // legacy hash redirects from upstream
    if (page === 'debug') { page = 'logs'; }
    if (page === 'codex-auth') { page = 'codex-set'; }
    if (page === 'lab') { page = 'models'; }
    if (page === 'api' || page === 'claude' || page === 'grok') { page = 'integrations'; }
    document.querySelectorAll('.navrow[data-page]').forEach(function (b) {
      b.classList.toggle('active', b.getAttribute('data-page') === page);
    });
    el('crumb').textContent = TITLES[page] || page;
    var inner = el('mainInner');
    var view;
    switch (page) {
      case 'codex-set': view = codexSetView(); break;
      case 'providers': view = providersView(); break;
      case 'models': view = modelsView(r.sub); break;
      case 'subagents': view = subagentsView(); break;
      case 'logs': view = logsView(r.sub); break;
      case 'usage': view = usageView(); break;
      case 'storage': view = storageView(); break;
      case 'integrations': view = integrationsView(r.sub); break;
      default: view = dashboardView();
    }
    inner.innerHTML = view;
    switch (page) {
      case 'providers': bindProviders(); break;
      case 'codex-set': bindCodexSet(); break;
      case 'models': bindModels(r.sub); break;
      case 'subagents': bindSubagents(); break;
      case 'logs': bindLogs(r.sub); break;
      case 'integrations': bindIntegrations(r.sub); break;
      default: bindDashboard();
    }
  }

  /* ---------- proxy status polling ---------- */
  function pollStatus() {
    getJSON('/api/status').then(function (s) {
      apiState.status = s;
      var badge = el('proxyStatus');
      var ok = s.status === 'running';
      badge.textContent = ok ? 'proxy · running · up ' + fmtUptime(s.uptime) : 'proxy · offline';
      badge.style.color = ok ? 'var(--green)' : 'var(--red)';
      el('proxySpinner').style.display = 'none';
    }).catch(function () {
      el('proxyStatus').textContent = 'proxy · offline';
      el('proxyStatus').style.color = 'var(--red)';
      el('proxySpinner').style.display = 'none';
    });
  }

  function loadState() {
    getJSON('/api/providers').then(function (p) { apiState.providers = Array.isArray(p) ? p : []; apiState._models = []; getJSON('/v1/models').then(function (m) { apiState._models = (m.data || []).map(function (x) { return { id: x.id, group: x.owned_by || '', ctx: 131072, tier: 'free' }; }); render(); }); render(); });
    getJSON('/api/settings').then(function (s) { apiState.settings = s || {}; });
    getJSON('/api/keys').then(function (k) { apiState.keys = Array.isArray(k) ? k : []; });
    getJSON('/api/logs').then(function (l) { apiState.logs = Array.isArray(l) ? l : []; });
  }

  function render() { router(undefined, false); }

  /* ---------- theme ---------- */
  function applyTheme(t) {
    if (t === 'light' || t === 'dark') { document.documentElement.setAttribute('data-theme', t); }
    else { document.documentElement.removeAttribute('data-theme'); }
    el('themeLabel').textContent = 'Theme: ' + t.charAt(0).toUpperCase() + t.slice(1);
  }
  function toggleTheme() {
    var cur = localStorage.getItem('ocx-theme') || 'system';
    cur = (cur === 'system') ? 'light' : (cur === 'light' ? 'dark' : 'system');
    localStorage.setItem('ocx-theme', cur);
    applyTheme(cur);
  }

  function init() {
    var theme = localStorage.getItem('ocx-theme') || 'system';
    applyTheme(theme);

    document.querySelectorAll('.navrow[data-page]').forEach(function (b) {
      b.addEventListener('click', function () { location.hash = '/' + b.getAttribute('data-page'); router(undefined, false); });
    });
    el('themeBtn').addEventListener('click', toggleTheme);
    el('restartBtn').addEventListener('click', function () {
      try { fetch('/restart', { method: 'POST' }); } catch (e) {}
      setTimeout(function () { location.reload(); }, 800);
    });
    el('menuBtn').addEventListener('click', function () { el('rail').classList.toggle('open'); });
    el('modalBackdrop').addEventListener('click', function (e) { if (e.target === el('modalBackdrop')) closeModal(); });
    window.addEventListener('hashchange', function () { render(); });
    loadState();
    pollStatus();
    setInterval(pollStatus, 4000);
  }

  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', init); }
  else { init(); }
})();

<\/script>
</body>
</html>`;


const DAGESTAN_DASH = '<!DOCTYPE html>\n<html lang="en">\n<head>\n<meta charset="utf-8" />\n<meta name="viewport" content="width=device-width,initial-scale=1" />\n<title>Dagestan Dashboard</title>\n<style>\n:root{--bg:#0b0d12;--fg:#e8eaed;--muted:#7b8497;--accent:#38bdf8;--card:#11141b;--border:#1e2230}\n*{box-sizing:border-box;margin:0;padding:0}\nhtml,body{height:100%}\nbody{font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:var(--bg);color:var(--fg);display:flex;align-items:center;justify-content:center;padding:1.5rem}\n.shell{max-width:520px;width:100%;background:var(--card);border:1px solid var(--border);border-radius:14px;padding:1.5rem}\nh1{font-size:1.1rem;font-weight:600;margin-bottom:.25rem}\np{color:var(--muted);font-size:.875rem;line-height:1.5;margin-bottom:1rem}\n.btn{display:inline-flex;align-items:center;gap:.5rem;background:var(--accent);color:#0b0d12;text-decoration:none;padding:.55rem 1rem;border-radius:8px;font-weight:600;font-size:.875rem}\n.btn:hover{filter:brightness(1.1)}\n.kbd{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.75rem;background:#0b0d12;border:1px solid var(--border);padding:.1rem .35rem;border-radius:4px}\n</style>\n</head>\n<body>\n<div class="shell">\n<h1>Dagestan Dashboard</h1>\n<p>This service\'s API is reachable at <span class="kbd">/v1/chat/completions</span>. The unified web dashboard lives on the main Dagestan port.</p>\n<a class="btn" href="http://127.0.0.1:5173/dashboard">Open Dagestan Dashboard &rarr;</a>\n</div>\n</body>\n</html>';
const server = http.createServer(async (req, res) => {
  res.setHeader('X-Proxy-Name', 'dagestan-opencodex');
  if (SETTINGS.cors) {
    res.setHeader('Access-Control-Allow-Origin', '*');
    res.setHeader('Access-Control-Allow-Methods', 'GET, POST, OPTIONS, DELETE');
    res.setHeader('Access-Control-Allow-Headers', 'Content-Type, Authorization');
  }
  if (req.method === 'OPTIONS') { res.writeHead(204); return res.end(); }
  const u = new URL(req.url, 'http://127.0.0.1:' + PORT);
  if (req.method === 'GET' && (u.pathname === '/' || u.pathname === '/index.html' || u.pathname === '')) { res.writeHead(200, {'Content-Type':'text/html; charset=utf-8'}); return res.end(DAGESTAN_DASH); }

  if (u.pathname === '/readyz') { res.writeHead(200); return res.end('ok'); }
  if (u.pathname === '/api/status') {
    res.writeHead(200, {'Content-Type':'application/json'});
    return res.end(JSON.stringify({status:'running', port:PORT, uptime:process.uptime(), requests:_reqCount, providers:PROVIDERS.length, models:MODELS.length, version:'3.1.0'}));
  }
  if (u.pathname === '/api/providers') {
    if (req.method === 'GET') { res.writeHead(200, {'Content-Type':'application/json'}); return res.end(JSON.stringify(PROVIDERS)); }
    if (req.method === 'POST') {
      let b=''; for await (const c of req) b+=c;
      try { const p=JSON.parse(b); p.id='p'+Date.now(); PROVIDERS.push(p); log('info','provider added: '+p.name); res.writeHead(200,{'Content-Type':'application/json'}); return res.end(JSON.stringify(p)); }
      catch(e){ res.writeHead(400); return res.end('bad json'); }
    }
    if (req.method === 'DELETE') {
      const id = u.searchParams.get('id');
      const i = PROVIDERS.findIndex(p=>p.id===id);
      if (i>=0){ const [removed]=PROVIDERS.splice(i,1); log('warn','provider removed: '+removed.name); }
      res.writeHead(200,{'Content-Type':'application/json'}); return res.end('{}');
    }
  }
  if (u.pathname === '/api/settings') {
    if (req.method === 'POST') {
      let b=''; for await (const c of req) b+=c;
      try { const s=JSON.parse(b); Object.assign(SETTINGS,s); log('info','settings saved'); return res.end(JSON.stringify({ok:true})); }
      catch(e){ res.writeHead(400); return res.end('bad json'); }
    }
    res.writeHead(200,{'Content-Type':'application/json'}); return res.end(JSON.stringify(SETTINGS));
  }
  if (u.pathname === '/api/keys') {
    if (req.method === 'POST') {
      let b=''; for await (const c of req) b+=c;
      try { const k=JSON.parse(b); k.id='k'+Date.now(); KEY_POOL.push(k); log('info','key added to pool: '+(k.name||k.key.slice(0,8))); return res.end(JSON.stringify({ok:true,count:KEY_POOL.length})); }
      catch(e){ res.writeHead(400); return res.end('bad json'); }
    }
    if (req.method === 'DELETE') { KEY_POOL.length=0; log('warn','key pool cleared'); return res.end('{}'); }
    res.writeHead(200,{'Content-Type':'application/json'}); return res.end(JSON.stringify(KEY_POOL.map(k=>({id:k.id,name:k.name,provider:k.provider}))));
  }
  if (u.pathname === '/api/logs') {
    res.writeHead(200, {'Content-Type':'application/json'});
    return res.end(JSON.stringify(_log));
  }
  if (u.pathname === '/v1/models') { res.writeHead(200, {'Content-Type':'application/json'}); return res.end(JSON.stringify({ object: 'list', data: FREE_MODELS })); }

  // ---- OpenAI-compatible chat completions proxy ----
  if (req.method === 'POST' && (u.pathname === '/v1/chat/completions' || u.pathname === '/v1/responses')) {
    _reqCount++;
    // Dagestan shared router — handles openrouter/*, nvidia/*, etc.
    let _bodyRaw = await readBodyRaw(req);
    let _payload = {}; try { _payload = JSON.parse(_bodyRaw || '{}'); } catch { res.writeHead(400, {'Content-Type':'application/json'}); return res.end(JSON.stringify({ error: { message: 'Invalid JSON' } })); }
    if (_payload && _payload.model) {
      const _routed = routeProxyChat(_payload, res, !!_payload.stream, { 'Access-Control-Allow-Origin': '*' });
      if (_routed && _routed.handled) return;
    }

    _reqCount++;
    if (SETTINGS.requireKey) {
      const auth = req.headers['authorization'] || '';
      const key = auth.replace(/^Bearer\s+/i, '');
      const poolOk = KEY_POOL.some(k => k.key === key) || (PROVIDERS.some(p => p.key && p.key === key));
      if (!key || (!poolOk && !process.env.DAGESTAN_MASTER_KEY)) {
        log('warn', 'rejected request: missing/invalid API key');
        res.writeHead(401, {'Content-Type':'application/json'});
        return res.end(JSON.stringify({ error: { message: 'Incorrect API key provided', type:'invalid_request_error' } }));
      }
    }
    let bodyRaw=''; for await (const c of req) bodyRaw+=c;
    let body={}; try { body=JSON.parse(bodyRaw); } catch(e){ res.writeHead(400); return res.end(JSON.stringify({error:{message:'Invalid JSON'} })); }
    const modelId = body.model || SETTINGS.defaultModel;
    const provider = pickProvider(modelId, u.searchParams.get('provider'));
    log('info', 'POST '+modelId+' via '+(provider?provider.name:'none'));
    body.model = (modelId === 'auto') ? (body.model || MODELS[2].id) : modelId;
    try {
      const { upstream, keyName } = await streamIfPossible(provider, body);
      res.writeHead(200, {'Content-Type':'application/json'});
      if (body.stream) {
        res.write('data: ' + JSON.stringify({id:'chatcmpl-'+crypto.randomBytes(6).toString('hex'),object:'chat.completion.chunk',created:Math.floor(Date.now()/1000),model:modelId,choices:[{index:0,delta:{role:'assistant',content:''},finish_reason:null}]}) + '\n\n');
        for await (const chunk of upstream.body) res.write(chunk);
        if (res.writableEnded === false) { res.write('data: [DONE]\n\n'); res.end(); }
      } else {
        let data=''; for await (const chunk of upstream.body) data+=chunk;
        res.end(data);
      }
    } catch (e) {
      log('error', 'upstream call failed: '+e.message);
      res.writeHead(502, {'Content-Type':'application/json'});
      res.end(JSON.stringify({ error:{ message:'Upstream error: '+e.message, type:'upstream_error' } }));
    }
    return;
  }

  // ---- Serve the rebranded GUI ----
  if (req.method === 'GET') {
    res.writeHead(200, {'Content-Type':'text/html; charset=utf-8'});
    return res.end(HTML);
  }
  res.writeHead(404); res.end('not found');
});

server.listen(10101, '0.0.0.0', () => console.log('OpenCodex proxy on :'+PORT));
