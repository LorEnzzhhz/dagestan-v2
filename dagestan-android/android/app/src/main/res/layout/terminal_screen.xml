<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen proot shell overlay -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/terminalView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020617"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:background="#0F172A">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Terminal — proot shell"
            android:textColor="#F8FAFC"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnTerminalClear"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="⌫"
            android:textSize="18sp"
            android:textColor="#94A3B8"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Clear" />

        <TextView
            android:id="@+id/btnTerminalClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="✕"
            android:textSize="16sp"
            android:textColor="#94A3B8"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/terminalScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:fillViewport="true">

        <TextView
            android:id="@+id/terminalOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoLink="web"
            android:linksClickable="true"
            android:fontFamily="monospace"
            android:textColor="#E2E8F0"
            android:textColorHint="#475569"
            android:textSize="12sp"
            android:textIsSelectable="true"
            android:hint="Tap a command below or type one to run it in the Dagestan environment." />
    </ScrollView>

    <!-- Quick commands (login lives here, not in the startup flow) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:background="#0F172A">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/chipCodexLogin"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/btn_secondary"
                android:text="codex login"
                android:textAllCaps="false"
                android:fontFamily="monospace"
                android:textColor="#34D399"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/chipLoginStatus"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/btn_secondary"
                android:text="login status"
                android:textAllCaps="false"
                android:fontFamily="monospace"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/chipGatewayStatus"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/btn_secondary"
                android:text="openclaw status"
                android:textAllCaps="false"
                android:fontFamily="monospace"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/chipDisk"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/btn_secondary"
                android:text="df -h"
                android:textAllCaps="false"
                android:fontFamily="monospace"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/chipOcxStatus"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/btn_secondary"
                android:text="ocx status"
                android:textAllCaps="false"
                android:fontFamily="monospace"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#0F172A">

        <EditText
            android:id="@+id/terminalInput"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/btn_secondary"
            android:fontFamily="monospace"
            android:hint="command…"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#475569"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTerminalRun"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="@drawable/btn_primary"
            android:text="Run"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
